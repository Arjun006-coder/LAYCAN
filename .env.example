# Environment Keys for LAYCAN Decision Engine
# Copy this file to .env and fill in your keys.
# Keys marked [FREE] require only registration — no payment.

# [FREE] Google Gemini API — used for agent reasoning, memo prose, and Critic narrative
# Get from: https://aistudio.google.com/
GEMINI_API_KEY=

# [FREE] US Energy Information Administration API v2 — Brent crude + marine fuel prices
# Get from: https://www.eia.gov/opendata/register.php
EIA_API_KEY=

# [OPTIONAL FREE] AISstream.io — live coastal AIS vessel positions near Indian ports
# Get from: https://aisstream.io/
AISSTREAM_API_KEY=

# ─── NO KEY REQUIRED ──────────────────────────────────────────────────────────
# The following data sources work without any key and are called directly:
#   - IMF PortWatch ArcGIS REST API  (port congestion, dry bulk port calls)
#   - Open-Meteo Marine API          (wave height, swell index, Bay of Bengal)
#   - yfinance                       (BDRY, SBLK, GNK, GOGL market proxies)
#   - SEC EDGAR API                  (requires only User-Agent header)
#   - World Bank Pink Sheet          (coal/iron ore FOB benchmark prices)
#   - NOAA IBTrACS                   (Bay of Bengal cyclone tracks)
#   - GDELT DOC 2.0                  (port disruption news event volume)
# ─────────────────────────────────────────────────────────────────────────────
