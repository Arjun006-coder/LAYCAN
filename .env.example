# LAYCAN — environment configuration
# cp .env.example .env   then fill the four REQUIRED values below.
# Never commit .env. Confirm .gitignore covers it before your first push.

# ─────────────────────────────────────────────────────────────────────
# REQUIRED — the build will not run without these
# ─────────────────────────────────────────────────────────────────────

# Google Gemini — the agent layer.  https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TEMPERATURE=0.1

# US Energy Information Administration v2 — bunker/crude proxies.
# https://www.eia.gov/opendata/register.php
EIA_API_KEY=

# SEC EDGAR requires a descriptive User-Agent with a real contact email
# or it returns 403. Put a team email here.
SEC_USER_AGENT=LAYCAN SIH2026 Research <your-team-email@example.com>

# aisstream.io — free coastal AIS over WebSocket.  https://aisstream.io
AISSTREAM_API_KEY=

# ─────────────────────────────────────────────────────────────────────
# NO KEY REQUIRED — endpoints only. Pin these once verified, so a
# silent upstream change shows up as a failing test, not a wrong number.
# ─────────────────────────────────────────────────────────────────────

# ⚠️ RESOLVE FIRST: your notes contain both Daily_Trade_Data and
# Daily_Ports_Data as "the confirmed endpoint". They are different
# layers. Pin the real one and save a sample response to
# tests/fixtures/portwatch_sample.json before writing the parser.
PORTWATCH_BASE_URL=https://services9.arcgis.com/weJ1QsnbMYJlCHdG/arcgis/rest/services
PORTWATCH_SERVICE=Daily_Ports_Data
PORTWATCH_LAYER=0

# Verified present. Gangavaram is NOT in this list — confirm separately.
PORTWATCH_PORT_IDS=port883,port1367,port290,port2299,port599,port442,port534,port529,port207,port235,port544

OPENMETEO_MARINE_URL=https://marine-api.open-meteo.com/v1/marine
GDELT_DOC_URL=https://api.gdeltproject.org/api/v2/doc/doc
IBTRACS_NI_CSV=https://www.ncei.noaa.gov/data/international-best-track-archive-for-climate-stewardship-ibtracs/v04r00/access/csv/ibtracs.NI.list.v04r00.csv
SEC_EDGAR_BASE=https://data.sec.gov

# BDRY holds rolling FFA positions — use daily RETURNS as a factor,
# never the price level as a freight rate. Confirm it still trades and
# check its real inception date before assuming history depth.
MARKET_PROXY_TICKERS=BDRY,SBLK,GNK,GOGL
SEC_CIKS=

# ─────────────────────────────────────────────────────────────────────
# INFRASTRUCTURE
# ─────────────────────────────────────────────────────────────────────

POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=laycan
POSTGRES_USER=laycan
POSTGRES_PASSWORD=change-me-locally
DATABASE_URL=postgresql://laycan:change-me-locally@db:5432/laycan
REDIS_URL=redis://cache:6379/0

API_HOST=0.0.0.0
API_PORT=8000
NEXT_PUBLIC_API_BASE=http://localhost:8000

# ─────────────────────────────────────────────────────────────────────
# BEHAVIOUR FLAGS — these are not conveniences, they are the demo
# ─────────────────────────────────────────────────────────────────────

# false ⇒ deterministic core only, no LLM narration. The full decision
# memo MUST still render with every number intact. Test this in CI.
# It is also your survival path when the Gemini free quota runs out
# mid-rehearsal, which it will.
LLM_ENABLED=true

# true ⇒ read the frozen snapshot, make zero network calls, produce
# byte-identical output. This is what you run on stage. Venue wifi has
# ended more good projects than bad code has.
DEMO_MODE=false
DEMO_SNAPSHOT=data/snapshots/demo-v1

# Reuse cached agent narrations instead of re-billing the quota.
LLM_CACHE_ENABLED=true
LLM_CACHE_DIR=.cache/llm

# Fails the build if any LLM response contains a numeral. Do not
# disable this to make a test pass — it is the reason the output is
# auditable, and it is a slide.
ENFORCE_NO_NUMERALS=true

# Fails the build if any feature query returns a row whose
# retrieved_at is later than the as_of timestamp. Guards the backtest
# against look-ahead leakage. Retrofitting this later means rerunning
# everything and not believing the results.
ENFORCE_POINT_IN_TIME=true

SCHEDULER_ENABLED=true
LOG_LEVEL=INFO
